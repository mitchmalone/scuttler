# ~/.config/git/scuttler.gitconfig — generated by scuttler; your identity and
# the rest stay in ~/.config/git/config, which includes this file.
@@PAGER@@
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true

[merge]
	conflictstyle = zdiff3

# Colours from the current theme.
[include]
	path = ~/.local/state/scuttler/current/theme/delta.gitconfig

#!/bin/zsh
# scuttler — the CLI. zsh 5.9, nothing else (DEVIATIONS.md).
#
# Runnable from a checkout (`bin/scuttler doctor`) or from the app bundle
# (`scuttler.app/Contents/Resources/setup/bin/scuttler`, which `link` puts on
# PATH); SCUTTLER_BASE is derived from this file's real location unless the
# environment says otherwise.

emulate -L zsh
setopt err_exit no_unset pipe_fail

SCUTTLER_BASE="${SCUTTLER_BASE:-${0:A:h:h}}"
export SCUTTLER_BASE
source "$SCUTTLER_BASE/lib/core.zsh"
source "$SCUTTLER_BASE/lib/manifest.zsh"
source "$SCUTTLER_BASE/lib/snapshot.zsh"
source "$SCUTTLER_BASE/lib/defaults.zsh"
source "$SCUTTLER_BASE/lib/files.zsh"
source "$SCUTTLER_BASE/lib/doctor.zsh"
source "$SCUTTLER_BASE/lib/link.zsh"
source "$SCUTTLER_BASE/lib/migrations.zsh"
source "$SCUTTLER_BASE/lib/shell.zsh"
source "$SCUTTLER_BASE/lib/remove.zsh"
source "$SCUTTLER_BASE/lib/sudoers.zsh"

usage() {
  cat <<EOF
scuttler ${SCUTTLER_VERSION} — scuttle the ship, sail the wreck.

  scuttler doctor                 what differs from base ⊕ overlay (read-only)
  scuttler defaults               plan: every macOS default that would change
  scuttler defaults --apply       apply them (snapshot first; asks once, --yes skips)
  scuttler shell                  plan: zsh, prompt, Ghostty, tmux, git configs from base ⊕ overlay
  scuttler shell --apply          write them (adopting what's there), clone the zsh plugins
  scuttler link | unlink          put scuttler on PATH (~/.local/bin), or take it off
  scuttler migrate                run the base migrations this machine hasn't yet
  scuttler sudoers on | off       let awake switch macOS sleep off while it holds (one password)
  scuttler remove                 undo every owned path and default; asks, --yes skips
  scuttler help | version

Base     $(sc_tilde "$SCUTTLER_BASE")
Overlay  $(sc_tilde "$SCUTTLER_OVERLAY")
State    $(sc_tilde "$SCUTTLER_STATE")
EOF
}

cmd_defaults() {
  local apply=0 yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) apply=1 ;;
      --yes|-y) yes=1 ;;
      *) sc_die "defaults: unknown option '$arg'" ;;
    esac
  done
  sc_defaults_run plan
  if (( SC_DEFAULTS_CHANGED == 0 )); then
    sc_ok "defaults: all ${SC_DEFAULTS_SEEN} keys already as declared"
    return 0
  fi
  print >&2
  sc_log "${SC_DEFAULTS_CHANGED} of ${SC_DEFAULTS_SEEN} keys would change"
  (( apply )) || { sc_log "run with --apply to change them"; return 0; }
  if (( ! yes )); then
    sc_confirm "apply?" || { print >&2; sc_log "left as is"; return 0; }
    print >&2
  fi
  sc_defaults_run apply
  print >&2
  if (( SC_DEFAULTS_FAILED > 0 )); then
    sc_warn "${SC_DEFAULTS_CHANGED} changed, ${SC_DEFAULTS_FAILED} refused (see above)"
    return 1
  fi
  sc_ok "${SC_DEFAULTS_CHANGED} changed; some take effect after logout"
}

cmd_shell() {
  local apply=0 yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) apply=1 ;;
      --yes|-y) yes=1 ;;
      *) sc_die "shell: unknown option '$arg'" ;;
    esac
  done
  sc_head "shell"
  sc_shell_run plan
  if (( SC_SHELL_CHANGED == 0 )); then
    sc_ok "shell: all ${SC_SHELL_SEEN} files already as rendered"
    return 0
  fi
  print >&2
  sc_log "$(( SC_SHELL_CHANGED - SC_SHELL_PLUGINS )) of ${SC_SHELL_SEEN} files would change, ${SC_SHELL_PLUGINS} plugin(s) to clone"
  (( apply )) || { sc_log "run with --apply to write them"; return 0; }
  if (( ! yes )); then
    sc_confirm "apply?" || { print >&2; sc_log "left as is"; return 0; }
    print >&2
  fi
  sc_shell_run apply
  print >&2
  sc_ok "shell written; open a new terminal (or \`exec zsh\`) to pick it up"
}

cmd_link() {
  (( $# == 0 )) || sc_die "link: takes no options"
  sc_link_run apply
}

cmd_unlink() {
  (( $# == 0 )) || sc_die "unlink: takes no options"
  sc_unlink_run apply
}

cmd_migrate() {
  (( $# == 0 )) || sc_die "migrate: takes no options"
  sc_migrate
}

cmd_remove() {
  local yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      *) sc_die "remove: unknown option '$arg'" ;;
    esac
  done
  sc_head "remove"
  sc_remove_run plan
  if (( SC_REMOVE_CHANGED == 0 )); then
    sc_ok "nothing to remove"
    return 0
  fi
  print >&2
  sc_log "${SC_REMOVE_PATHS} owned path(s) to remove, ${SC_REMOVE_RESTORED} original(s) to restore, ${SC_REMOVE_DEFAULTS} default(s) to put back"
  sc_log "overlay $(sc_tilde "$SCUTTLER_OVERLAY") stays; so do Homebrew and the app"
  if (( ! yes )); then
    sc_confirm "remove?" || { print >&2; sc_log "left as is"; return 0; }
    print >&2
  fi
  sc_remove_run apply
  print >&2
  sc_ok "removed; some defaults take effect after logout"
}

main() {
  local cmd="${1:-help}"; shift 2>/dev/null || true
  case "$cmd" in
    doctor)   sc_doctor ;;
    defaults) cmd_defaults "$@" ;;
    shell)    cmd_shell "$@" ;;
    link)     cmd_link "$@" ;;
    unlink)   cmd_unlink "$@" ;;
    migrate)  cmd_migrate "$@" ;;
    remove)   cmd_remove "$@" ;;
    sudoers)  sc_sudoers "$@" ;;
    version)  print -r -- "$SCUTTLER_VERSION" ;;
    help|-h|--help) usage ;;
    *) sc_err "unknown command '$cmd'"; usage; return 1 ;;
  esac
}

main "$@"
